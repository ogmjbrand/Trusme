# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required) -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used by the execution engine,
# webhooks and public share links after explicit server-side checks.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (optional; without it the rule-based planner is used) --------
# anthropic | openai | none
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Background execution --------------------------------------------------------
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# --- Email delivery (optional; required to send reminders / supplier POs) ------
RESEND_API_KEY=
EMAIL_FROM="TrustOS <billing@example.com>"

# --- Payments (optional) ---------------------------------------------------------
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Trust & safety providers (optional) -----------------------------------------
GOOGLE_SAFE_BROWSING_API_KEY=
